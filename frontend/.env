# Leave VITE_API_URL EMPTY so the browser calls /api on the SAME host it
# loaded the page from. Vite then proxies /api to the backend.
#
# This is what makes the app work on any device / any network:
#   - laptop  -> http://localhost:5173      -> proxy -> 127.0.0.1:8000
#   - mobile  -> http://192.168.1.11:5173   -> proxy -> 127.0.0.1:8000
#
# If you set this to http://localhost:8000, phones will try to reach THEIR OWN
# localhost and every API call fails. Only set it when the frontend and backend
# are genuinely on different hosts.
VITE_API_URL=

# Backend that the Vite dev-server proxy forwards /api requests to.
VITE_BACKEND_URL=http://127.0.0.1:8000
